# Copy to .env for local work. Never commit .env. Never put production
# credentials here; production keys are configured in the hosting dashboards.

# Database tests against a real Postgres (optional). Leave unset to use the
# in-process PGlite harness. For Supabase local (`supabase start`) this is:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Supabase API for the apps (from `supabase status` when running locally)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server-side only (Edge Functions, notification dispatcher). Never ship to apps.
SUPABASE_SERVICE_ROLE_KEY=

# External integrations: "test" adapters record messages instead of sending.
# Switching any of these to a live provider requires founder authorization.
NOTIFY_PUSH_ADAPTER=test
NOTIFY_WHATSAPP_ADAPTER=test
PAYMENTS_ADAPTER=test
MAPS_ADAPTER=test
